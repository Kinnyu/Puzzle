      traditionalChinese: "\u6211\u60f3\uff0c\u6211\u5df2\u7d93\u77e5\u9053\u81ea\u5df1\u63a5\u4e0b\u4f86\u8a72\u505a\u4ec0\u9ebc\u4e86\u3002"
