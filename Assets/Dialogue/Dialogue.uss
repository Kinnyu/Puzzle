.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.dialogue-prompt {
    display: none;
    position: absolute;
    bottom: 8%;
    align-self: center;
    padding: 8px 20px;
    background-color: rgba(17, 24, 40, 0.93);
    color: #f6edd7;
    font-size: 18px;
    border-radius: 6px;
}

.dialogue-overlay {
    display: none;
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    color: #f6edd7;
}

.dialogue-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 40%;
    max-height: 100%;
    background-image: url("project://database/Assets/Dialogue/Subtitle%20Fade.png");
    background-size: 100% 100%;
}

.dialogue-portrait {
    display: none;
    position: absolute;
    bottom: 1.5%;
    left: 4%;
    width: 16%;
    height: 30%;
    max-width: 224px;
    max-height: 224px;
}

.dialogue-portrait-visible {
    display: flex;
}

.dialogue-portrait-right {
    left: auto;
    right: 4%;
}

.dialogue-card {
    width: 60%;
    max-width: 800px;
    max-height: 85%;
    margin-bottom: 3%;
}

.dialogue-scroll {
    flex-shrink: 1;
    min-height: 0;
}

.dialogue-toolbar {
    position: absolute;
    top: 18px;
    right: 20px;
    flex-direction: row;
}

.dialogue-speaker {
    font-size: 19px;
    color: #eac98d;
    white-space: normal;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(4, 8, 19, 0.95);
}

.dialogue-line {
    font-size: 22px;
    white-space: normal;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(4, 8, 19, 0.95);
}

.dialogue-control, .dialogue-action {
    background-color: #24334c;
    color: #f6edd7;
    border-width: 1px;
    border-color: #526483;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 16px;
}

.dialogue-action {
    margin: 0 0 6px;
    padding: 9px 12px;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.dialogue-advance {
    align-self: center;
    background-color: transparent;
    border-color: rgba(234, 201, 141, 0.35);
    color: #eac98d;
    font-size: 16px;
    padding: 3px 12px;
    -unity-text-align: middle-center;
}

.dialogue-control:focus, .dialogue-action:focus {
    border-color: #eac98d;
}

.dialogue-control:hover, .dialogue-action:hover {
    background-color: #354965;
}
