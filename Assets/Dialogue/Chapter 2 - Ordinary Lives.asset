%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16a28623c3134fcaabde08787e9d8c51, type: 3}
  m_Name: Chapter 2 - Ordinary Lives
  m_EditorClassIdentifier:
  entryNodeId: request
  nodes:
  - id: request
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我一直想幫助那些生活困苦的人，但最近卻遇到了不少挫折……"
      japanese: "苦しい暮らしを送る人たちを助けたいと思ってきたけれど、最近は挫折ばかりでね……。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: request-2
    choices: []
  - id: request-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我發現，光有想幫助別人的心，似乎還不夠。"
      japanese: "力になりたいという気持ちだけでは足りないみたいだ。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: request-3
    choices: []
  - id: request-3
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你願意替我去看看那些辛苦生活的人們嗎？"
      japanese: "僕の代わりに、懸命に生きる人たちの様子を見に行ってくれないか？"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "當然！我很樂意幫忙。"
        japanese: "もちろん。喜んで手伝うよ。"
      nextNodeId: request-yes
    - text:
        traditionalChinese: "我可以試試看，但不知道能幫上什麼忙。"
        japanese: "やってみるけど、何ができるかは分からない。"
      nextNodeId: request-try
  - id: request-yes
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "謝謝你！我相信你的善意一定能帶給他們溫暖。"
      japanese: "ありがとう。君の優しさなら、きっと力になれる。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId:
    choices: []
  - id: request-try
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "沒關係，有時候一點小小的幫助，就能帶來很大的改變。"
      japanese: "大丈夫。ほんの小さな手助けが、大きな変化を生むこともある。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId:
    choices: []
  - id: miner
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "唉……今天又在礦坑裡工作了一整天。"
      japanese: "はあ……今日も一日中、坑道で働きづめだ。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId: miner-2
    choices: []
  - id: miner-2
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "肚子餓得不得了，卻連一頓像樣的飯都吃不上。"
      japanese: "腹が減ってたまらないのに、まともな飯すら食えない。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId: miner-3
    choices: []
  - id: miner-3
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "如果能有點食物就好了……"
      japanese: "何か食べるものがあればなあ……。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId:
    choices: []
  - id: farm
    speaker:
      traditionalChinese: "農夫"
      japanese: "農夫"
    line:
      traditionalChinese: "哎呀！今天的農活可真多啊！"
      japanese: "やれやれ、今日も畑仕事が山ほどあるよ。"
    portrait: {fileID: 2800000, guid: 2d3b0e9bd5c1daf44848a7a59b231a42, type: 3}
    nextNodeId: farm-2
    choices: []
  - id: farm-2
    speaker:
      traditionalChinese: "農夫"
      japanese: "農夫"
    line:
      traditionalChinese: "年輕人，你願意幫我整理一下農田嗎？"
      japanese: "若いの、畑を耕すのを手伝ってくれないかい？"
    portrait: {fileID: 2800000, guid: 2d3b0e9bd5c1daf44848a7a59b231a42, type: 3}
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "沒問題，我來幫你！"
        japanese: "もちろん、手伝うよ。"
      nextNodeId: farm-accept
    - text:
        traditionalChinese: "好吧，看起來你真的很需要幫忙。"
        japanese: "いいよ。手が足りなさそうだね。"
      nextNodeId: farm-accept
  - id: farm-accept
    speaker:
      traditionalChinese: "農夫"
      japanese: "農夫"
    line:
      traditionalChinese: "翻一壟就好。我在另一頭鬆土。看，乾的土挖開，下面的顏色深得多。"
      japanese: "畝を一本だけ頼むよ。私は向こうをやる。ほら、乾いた土を掘ると、下はずっと濃い色だろう。"
    portrait: {fileID: 2800000, guid: 2d3b0e9bd5c1daf44848a7a59b231a42, type: 3}
    nextNodeId:
    choices: []
  - id: reward
    speaker:
      traditionalChinese: "農夫"
      japanese: "農夫"
    line:
      traditionalChinese: "你那一壟翻得很好。看，手上的土一時半刻還洗不掉呢。"
      japanese: "あの畝、よく掘れている。ほら、手についた土はなかなか落ちないだろう。"
    portrait: {fileID: 2800000, guid: 2d3b0e9bd5c1daf44848a7a59b231a42, type: 3}
    nextNodeId: reward-2
    choices: []
  - id: reward-2
    speaker:
      traditionalChinese: "農夫"
      japanese: "農夫"
    line:
      traditionalChinese: "帶這袋馬鈴薯去吧。我本來留了一半給晚飯，今天還能再挖一些。"
      japanese: "この袋のジャガイモを持っていきな。半分は夕飯のつもりだったが、今日はまだ掘れそうだ。"
    portrait: {fileID: 2800000, guid: 2d3b0e9bd5c1daf44848a7a59b231a42, type: 3}
    nextNodeId:
    choices: []
  - id: delivery
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "你回來了。我還以為你有別的事要忙，正要走。"
      japanese: "戻ってきてくれたのか。用事ができたのかと思って、帰るところだった。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId: potato
    choices: []
  - id: potato
    speaker:
      traditionalChinese: "玩家"
      japanese: "あなた"
    line:
      traditionalChinese: "農夫讓我把這袋帶來。還沾著土呢。"
      japanese: "農夫がこの袋を持っていけって。まだ土がついてる。"
    nextNodeId: thanks
    choices: []
  - id: thanks
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "你可以在這兒坐一會兒嗎？我把它們洗一洗。"
      japanese: "少し、ここに座っていかないか？ 洗ってくるから。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "留下來，幫他一起洗。"
        japanese: "残って、一緒に洗う。"
      nextNodeId: wash
    - text:
        traditionalChinese: "幫他把袋子拿到桌上。"
        japanese: "袋を台まで運ぶ。"
      nextNodeId: carry
  - id: thanks-2
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "這顆先留著。我隔壁那位還沒下工，他回來向來比我晚。"
      japanese: "これは取っておこう。隣のやつはまだ仕事中だ。いつも僕より帰りが遅いんだ。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId: thanks-3
    choices: []
  - id: thanks-3
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "你明天要是經過這裡，可以再來坐坐。"
      japanese: "明日この辺を通るなら、また座っていってくれ。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    nextNodeId:
    choices: []
  - id: theo
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "你好！請問你認識文森特・梵谷嗎？"
      japanese: "こんにちは。フィンセント・ファン・ゴッホを知っていますか？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId: theo-player
    choices: []
  - id: theo-player
    speaker:
      traditionalChinese: "玩家"
      japanese: "あなた"
    line:
      traditionalChinese: "認識！我正準備回去找他。"
      japanese: "知ってるよ。今から彼に会いに行くところだ。"
    nextNodeId: theo-ask
    choices: []
  - id: theo-ask
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "太好了！我是他的弟弟西奧。哥哥最近經歷了不少挫折，我一直很擔心他。"
      japanese: "よかった。弟のテオです。兄は最近つらいこと続きで、ずっと心配していました。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId: theo-ask-2
    choices: []
  - id: theo-ask-2
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "我寫了一封信給他，你能幫我轉交嗎？"
      japanese: "兄に手紙を書きました。渡してもらえませんか？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "當然可以！"
        japanese: "もちろん。"
      nextNodeId: theo-yes
    - text:
        traditionalChinese: "信裡寫了什麼呢？"
        japanese: "何を書いたの？"
      nextNodeId: theo-ask-letter
  - id: theo-yes
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "太感謝你了！希望這封信能讓哥哥重新振作起來。"
      japanese: "ありがとう。この手紙で兄が少しでも元気を取り戻してくれたら。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId: theo-money
    choices: []
  - id: theo-ask-letter
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "我只是想讓他知道，不管遇到什麼困難，他都不是孤單一個人。"
      japanese: "どんな困難に遭っても、ひとりじゃないと伝えたかったんです。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId: theo-money
    choices: []
  - id: theo-money
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "另外，我也準備了一些生活費，希望能減輕他的負擔。"
      japanese: "生活費も少し用意しました。兄の負担が軽くなればと思って。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    nextNodeId:
    choices: []
  - id: return-with-letter
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你回來了！怎麼樣？有遇到需要幫助的人嗎？"
      japanese: "おかえり。どうだった？ 助けを必要としている人に会えたかい？"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: report-with-letter
    choices: []
  - id: report-with-letter
    speaker:
      traditionalChinese: "玩家"
      japanese: "あなた"
    line:
      traditionalChinese: "他把一顆推到桌角，說要留給還沒下工的人。我想起了你在教堂留的外套。"
      japanese: "まだ帰っていない人の分だと言って、一つを台の隅に寄せたんだ。教会に置いた上着のことを思い出した。"
    nextNodeId: reflect-with-letter
    choices: []
  - id: reflect-with-letter
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "那張桌子旁是什麼樣子？他把馬鈴薯推開的時候，手放在哪裡？"
      japanese: "その台のまわりはどんなだった？ ジャガイモを寄せたとき、手はどこにあった？"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: reflect-with-letter-2
    choices: []
  - id: reflect-with-letter-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你等一下……如果燈放在近一點的地方，應該看得見他指節上的土。"
      japanese: "ちょっと待って……灯りをもう少し近くに置けば、指の節についた土が見えるはずだ。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: reflect-with-letter-3
    choices: []
  - id: reflect-with-letter-3
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我想先把那雙手畫下來。"
      japanese: "まず、その手を描いておきたい。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: hand-over
    choices: []
  - id: return-without-letter
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你回來啦。礦工吃到東西了嗎？"
      japanese: "おかえり。鉱夫は何か食べられた？"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: report-without-letter
    choices: []
  - id: report-without-letter
    speaker:
      traditionalChinese: "玩家"
      japanese: "あなた"
    line:
      traditionalChinese: "嗯。他還留了一顆給隔壁沒下工的人。"
      japanese: "うん。まだ帰っていない隣の人の分も取っておいてた。"
    nextNodeId: reflect-without-letter
    choices: []
  - id: reflect-without-letter
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我剛才好像看見西奧在東邊那條路上。他常把信藏在外套內袋，怕弄濕了。可以去看看他是不是在等我嗎？"
      japanese: "さっき東の道にテオがいた気がする。手紙が濡れないよう、いつも上着の内ポケットに入れるんだ。僕を待っているのか、見てきてもらえる？"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId:
    choices: []
  - id: hand-over
    speaker:
      traditionalChinese: "玩家"
      japanese: "あなた"
    line:
      traditionalChinese: "我想起了西奧託我帶來的信。"
      japanese: "テオから預かった手紙を思い出した。"
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "對了，我還有一樣東西要交給你。"
        japanese: "そうだ、渡したいものがあるんだ。"
      nextNodeId: letter-reaction
  - id: letter-reaction
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "這是……西奧的信？原來他一直都這麼關心我……"
      japanese: "これは……テオの手紙？ ずっと僕を気にかけてくれていたんだね……。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: letter
    choices: []
  - id: letter
    speaker:
      traditionalChinese: "西奧的信"
      japanese: "テオの手紙"
    line:
      traditionalChinese: "親愛的文森特：我知道你最近經歷了許多困難，但請不要因此放棄自己。"
      japanese: "親愛なるフィンセント。最近つらいことが多かったね。どうか自分を諦めないでほしい。"
    nextNodeId: letter-2
    choices: []
  - id: letter-2
    speaker:
      traditionalChinese: "西奧的信"
      japanese: "テオの手紙"
    line:
      traditionalChinese: "無論未來遇到什麼挫折，你都可以依靠我。"
      japanese: "これから何があっても、僕を頼っていいんだ。"
    nextNodeId: letter-3
    choices: []
  - id: letter-3
    speaker:
      traditionalChinese: "西奧的信"
      japanese: "テオの手紙"
    line:
      traditionalChinese: "我也準備了一些生活費，希望能讓你安心追尋自己真正想做的事。"
      japanese: "生活費も少し用意した。安心して本当にやりたいことを探してほしい。"
    nextNodeId: letter-4
    choices: []
  - id: letter-4
    speaker:
      traditionalChinese: "西奧的信"
      japanese: "テオの手紙"
    line:
      traditionalChinese: "不管你選擇什麼道路，我都會支持你。——你的弟弟，西奧"
      japanese: "どんな道を選んでも、僕は応援するよ。弟のテオより。"
    nextNodeId: vincent-success
    choices: []
  - id: vincent-success
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "西奧……總是在我最需要幫助的時候支持我。"
      japanese: "テオは……僕がいちばん助けを必要とするとき、支えてくれるんだ。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: vincent-success-2
    choices: []
  - id: vincent-success-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "也許未來還會遇到很多困難，但我想繼續畫下去。"
      japanese: "これからも困難はあるだろう。それでも僕は描き続けたい。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: vincent-success-3
    choices: []
  - id: vincent-success-3
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "謝謝你替我帶來這封信，也謝謝你讓我重新看見那些平凡生命的價值。"
      japanese: "手紙を届けてくれてありがとう。人々の暮らしの価値に気づかせてくれたことにも感謝している。"
    portrait: {fileID: 2800000, guid: 54ee8aa8240009746935adc297842a37, type: 3}
    nextNodeId: success
    choices: []
  - id: success
    speaker:
      traditionalChinese: "旁白"
      japanese: "ナレーション"
    line:
      traditionalChinese: "經歷宗教工作的挫折後，梵谷逐漸找到了新的生命方向——繪畫。"
      japanese: "宗教活動での挫折を経て、ゴッホは絵画という新しい道を見出していった。"
    nextNodeId: success-2
    choices: []
  - id: success-2
    speaker:
      traditionalChinese: "旁白"
      japanese: "ナレーション"
    line:
      traditionalChinese: "他開始將目光投向平凡的勞動者，試圖透過畫筆，呈現他們辛勤生活的真實樣貌。"
      japanese: "彼は働く人たちに目を向け、日々の営みをありのまま描こうとした。"
