%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16a28623c3134fcaabde08787e9d8c51, type: 3}
  m_Name: Chapter 4 - The Unfinished Starlight
  m_EditorClassIdentifier:
  entryNodeId: visit
  nodes:
  - id: visit
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你來了……來到這裡接受照護後，我有時還是不太安穩。不過，只要拿起畫筆，我就還能留意窗外的光。"
      japanese: "来てくれたんだね。ここで治療を受けても、まだ落ち着かない時がある。でも筆を取ると、窓の外の光に目が向くんだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: visit-2
    choices: []
  - id: visit-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "還記得墓園那天，我們站在同一條路上，看到的東西卻不一樣嗎？這次，陪我看看窗外。"
      japanese: "墓地で同じ道に立っても、見えるものが違ったのを覚えてる？ 今度は窓の外を一緒に見てほしい。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: sky
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "星光在深藍色的夜空裡格外明亮。也許可以讓整片夜空在畫布上流動。"
      japanese: "深い青の中で星がひときわ明るい。夜空全体が絵の中で流れるように描けるかもしれない。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: cypress
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "柏樹的輪廓一直伸向天空，像把地面和星光連在了一起。"
      japanese: "糸杉の輪郭が空へ伸び、地上と星の光をつないでいるようだ。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: village
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "如果在天空下面畫一座寧靜的村莊，想像中的屋頂也能成為這片風景的一部分。"
      japanese: "空の下に静かな村を描こう。想像した屋根も、この風景の一部になる。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: starry-made
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "星光、柏樹，還有一座想像中的村莊……我知道該從哪裡畫起了。"
      japanese: "星の光、糸杉、そして想像の村……どこから描き始めるか分かったよ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: starry-made-2
    choices: []
  - id: starry-made-2
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "在療養院裡，梵谷仍持續畫畫。觀察到的風景和他的想像，一起變成了《星夜》。"
      japanese: "療養院でもゴッホは描き続けた。目にした景色と彼の想像が合わさり、『星月夜』が生まれた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: starry-missing
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我們再多看一點吧。窗外、庭院和畫架旁，都可能還藏著一點靈感。"
      japanese: "もう少し見てみよう。窓の外、中庭、イーゼルのそばにも、まだヒントがあるかもしれない。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: proposal
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "好久不見！文森特完成了新畫，我想讓更多人看到它。你願意和我一起籌辦一場畫展嗎？"
      japanese: "久しぶり！ フィンセントの新作を多くの人に見てもらいたいんだ。一緒に展覧会を準備してくれる？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId: proposal-2
    choices: []
  - id: proposal-2
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "《星夜》留在療養院，《吃馬鈴薯的人》和《阿里斯康墓園》在黃色小屋。把三幅畫帶去教堂北邊的小畫館吧。"
      japanese: "『星月夜』は療養院に、『ジャガイモを食べる人々』と『アリスカン』は黄色い家にある。三枚を教会の北の画廊へ運んでくれ。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: invite-brief
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "畫已經掛好了。教堂前應該還有人在聊天，去問問他們晚上想不想來。"
      japanese: "絵は掛け終わったよ。教会の前で話してる人がいるはずだ。よかったら今夜来ないか、聞いてみてくれる？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: invite-1
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "畫展？是誰的作品啊？"
      japanese: "展覧会？ 誰の作品なの？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-1-2
    choices: []
  - id: invite-1-2
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "是梵谷的作品。小畫館就在教堂北邊，歡迎來看看！"
      japanese: "ゴッホの作品です。教会の北の画廊へ、ぜひ見に来てください！"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-1-3
    choices: []
  - id: invite-1-3
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "聽起來不錯，我等等去看看！"
      japanese: "面白そう。あとで寄ってみるよ！"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: invite-2
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我不太懂藝術，也能去嗎？"
      japanese: "芸術に詳しくなくても行っていいの？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-2-2
    choices: []
  - id: invite-2-2
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "當然。停在喜歡的作品前看看，就已經在欣賞了。"
      japanese: "もちろん。好きな絵の前で立ち止まって眺めるだけでいいんです。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-2-3
    choices: []
  - id: invite-2-3
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "那我也想去。"
      japanese: "じゃあ行ってみたいな。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: invite-3
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "他的畫有什麼特別的地方？"
      japanese: "どんなところが特別なの？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-3-2
    choices: []
  - id: invite-3-2
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "鮮明的色彩和筆觸，都是他看待世界的方式。"
      japanese: "鮮やかな色と筆遣いに、彼の世界の見方が表れているんです。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-3-3
    choices: []
  - id: invite-3-3
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我會去看看的。"
      japanese: "見に行ってみるよ。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: invite-4
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "是在附近的小畫館嗎？散步回來我可以順路去。"
      japanese: "近くの小さな画廊？ 散歩の帰りに寄れるね。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-4-2
    choices: []
  - id: invite-4-2
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "就在教堂北邊，我們等你。"
      japanese: "教会の北です。お待ちしています。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: invite-5
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我聽說畫館換了新的作品。有他最近畫的星空嗎？"
      japanese: "画廊に新しい絵が入ったって聞いたよ。最近描いた星空も見られる？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: invite-5-2
    choices: []
  - id: invite-5-2
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "有，今晚就能看到《星夜》。"
      japanese: "ええ、今夜は『星月夜』も見られます。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: fame-brief
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "你請的人來了。有些站在自己喜歡的畫前，好像想問些什麼。你也去看看，我在這裡等文森特。"
      japanese: "誘ってくれた人が来たよ。好きな絵の前で、何か聞きたそうにしてる。一緒に見ておいで。僕はここでフィンセントを待つから。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: potato-good
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我父親下工後，指節也那樣。刷得再用力，指甲邊上還是有一圈黑的。"
      japanese: "父も仕事帰りは指の節があんなふうだった。いくらこすっても爪のきわが黒くてね。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: potato-poor
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "是啊。以前我們家只有一盞燈，父親總把它往坐得最遠的人那邊推。"
      japanese: "そうだね。うちにも灯りは一つだけで、父はいつも一番遠くに座る人のほうへ寄せていた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: cemetery-good
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我以前總在那裡走得很快。下次我想走到遠處那道光裡。"
      japanese: "いつも足早に通り過ぎてた。今度は奥のあの光まで歩いてみたいな。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: cemetery-poor
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我總抬頭看樹。原來低頭，也能看到一個完全不一樣的秋天。"
      japanese: "いつも木を見上げてばかりだった。目を落とすと、違う秋が見えるんだね。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: night-good
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "你的眼睛也會沿著光走嗎？我本來只盯著最亮的那一顆。"
      japanese: "君の目も光をたどる？ 私は最初、いちばん明るい星しか見ていなかった。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: night-poor
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "真的有一扇還亮著。謝謝，你剛才讓我看到這畫裡還住著人。"
      japanese: "本当だ、まだ明るい窓がある。ありがとう。この絵には人が暮らしているんだね。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: exhibition-end
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "今天有人在《星夜》前站了很久。文森特，你的畫真的被人看見了。"
      japanese: "今日、『星月夜』の前に長く立っている人がいたよ。フィンセント、君の絵はちゃんと見てもらえたんだ。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId: exhibition-end-2
    choices: []
  - id: exhibition-end-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我很開心。但我還是會擔心，自己以後能不能這樣畫下去。"
      japanese: "うれしいよ。だけど、これからもこうして描けるのか、ときどき不安になる。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: exhibition-end-3
    choices: []
  - id: exhibition-end-3
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "你不用一個人面對。我陪你去找醫師談談。"
      japanese: "一人で抱えなくていいんだ。一緒に先生のところへ行こう。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: doctor
    speaker:
      traditionalChinese: "醫師"
      japanese: "医師"
    line:
      traditionalChinese: "持續接受照護，也給自己規律休息和有人作伴的時間。今天可以依文森特的狀況，慢慢安排。"
      japanese: "治療を続けながら、休息と誰かと過ごす時間も大切にしてください。今日はフィンセントの調子に合わせて、ゆっくり過ごしましょう。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: doctor-2
    choices: []
  - id: doctor-2
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "那我們就陪他度過平靜的一天吧。先一起吃早餐。"
      japanese: "では、穏やかな一日を一緒に過ごそう。まず朝食からだね。"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: breakfast
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "文森特，今天我們就放慢腳步。早飯吃完，再一起出去走走吧。"
      japanese: "フィンセント、今日はゆっくり過ごそう。朝食のあと、一緒に散歩に行かない？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId: breakfast-2
    choices: []
  - id: breakfast-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "好啊。我想看看以前走過的那些地方。"
      japanese: "いいね。前によく歩いた場所を、また見てみたい。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: walk-church
    speaker:
      traditionalChinese: "神職人員"
      japanese: "聖職者"
    line:
      traditionalChinese: "你還記得小桌上那件外套嗎？隔天清早，我發現外套不見了，椅子倒是推得整整齊齊。"
      japanese: "小さな台に置いた上着、覚えてる？ 翌朝にはなくなっていたよ。椅子はきちんと元の場所に戻っていた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: walk-church-2
    choices: []
  - id: walk-church-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "他還是把椅子推回去了啊。……我到現在還不知道他的名字。"
      japanese: "やっぱり椅子を戻していったんだ。……その人の名前、今でも知らないな。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: walk-farm
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "還記得那天我把一顆馬鈴薯留在桌角嗎？現在有收成，我就留一袋在門邊。晚上下工的人會自己來拿。"
      japanese: "あの日、台の隅にジャガイモを一つ取っておいたのを覚えてるか？ 今は採れた日に袋を戸口に置く。仕事帰りのやつが持っていくんだ。"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    portraitOnRight: 0
    nextNodeId: walk-farm-pass
    choices: []
  - id: walk-farm-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "這樣回來的人就不用先解繩子了。"
      japanese: "これなら、帰ってきた人が紐をほどかなくてもいいね。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: walk-graves
    speaker:
      traditionalChinese: "高更的信"
      japanese: "ゴーギャンの手紙"
    line:
      traditionalChinese: "文森特，聽說有人特地來看你的畫。我們對繪畫的看法不同，可是在這裡一起寫生的秋天，對我依然很重要。請繼續走你自己的路。——高更"
      japanese: "フィンセント、君の絵を見に来た人がいたと聞いたよ。絵に対する考えは違うが、ここで一緒に写生した秋は今も大切に思っている。どうか自分の道を歩き続けてくれ。ゴーギャン"
    portrait: {fileID: 0}
    portraitOnRight: 1
    nextNodeId: walk-graves-2
    choices: []
  - id: walk-graves-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我也記得。我們不一定要走同一條路，才能珍惜曾經一起走過的那一段。"
      japanese: "僕も覚えている。同じ道を歩き続けなくても、一緒に歩いた時間を大切にできるね。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: lunch
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "散步回來後，大家一起吃了午餐。梵谷在窗邊休息了一會兒，看見屋外的花開了。"
      japanese: "散歩から戻り、みんなで昼食を取った。窓辺でひと休みしたゴッホは、家の外で花が咲いていることに気づいた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: lunch-2
    choices: []
  - id: lunch-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "那棵杏樹開了。我想在那裡坐一會兒。可以把小屋裡的畫具一起帶來嗎？"
      japanese: "あの杏の花が咲いたね。あそこで少し座っていたい。家にある画材も持ってきてくれる？"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: spring
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你坐這裡好嗎？花枝一動，我就看不準了。……等風停一下。"
      japanese: "ここに座ってくれる？ 枝が揺れるとよく見えなくて。……風がやむまで少し待とう。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: spring-2
    choices: []
  - id: spring-2
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "梵谷沾了一點顏料。你們等到枝頭不再搖晃，他才畫下第一筆。"
      japanese: "ゴッホは筆に少し絵の具を取った。枝が揺れなくなるのを待って、最初の一筆を置いた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "靜靜陪他畫完。"
        japanese: "静かに、描き終わるまでそばにいる。"
      nextNodeId: spring-stay
    - text:
        traditionalChinese: "告訴他哪一枝花吸引了你的目光。"
        japanese: "どの枝に目が留まったか伝える。"
      nextNodeId: spring-look
  - id: thanks
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "送給你。今天你陪我走過的那些地方，讓我想起自己留下過一些東西。"
      japanese: "君に贈るよ。今日一緒に歩いた場所で、僕が残してきたものを思い出した。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: thanks-2
    choices: []
  - id: thanks-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我不知道未來會怎樣。但至少現在，我還想繼續畫下去。"
      japanese: "未来のことは分からない。でも、少なくとも今は描き続けたいんだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: thanks-3
    choices: []
  - id: thanks-3
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "那就慢慢來。今天也可以先好好休息。"
      japanese: "じゃあ、ゆっくりいこう。今日はまず、ゆっくり休んでもいいんだよ。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: evening
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "傍晚，兩兄弟一起吃了晚餐。梵谷把新畫留在桌上，回房間休息。困難沒有消失，但他有定期的照護，也有人願意陪伴他。"
      japanese: "夕方、兄弟は一緒に夕食を取った。ゴッホは新しい絵を机に残し、部屋で休んだ。困難は消えなかったが、治療は続き、そばにいてくれる人もいた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: morning
    speaker:
      traditionalChinese: "西奧"
      japanese: "テオ"
    line:
      traditionalChinese: "早安，文森特。今天想做什麼？"
      japanese: "おはよう、フィンセント。今日は何をしたい？"
    portrait: {fileID: 2800000, guid: 2e53c57501dbae04492237f3085a37e4, type: 3}
    portraitOnRight: 1
    nextNodeId: morning-2
    choices: []
  - id: morning-2
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "或許……再畫一幅畫吧。"
      japanese: "そうだね……もう一枚、描こうかな。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: morning-3
    choices: []
  - id: morning-3
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "梵谷把昨天用過的筆放到水裡洗淨。窗邊還有一張空白的畫布。"
      japanese: "ゴッホは昨日の筆を水で洗った。窓辺にはまだ一枚、まっさらな画布があった。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: morning-4
    choices: []
  - id: morning-4
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "他把椅子挪到窗邊，留出旁邊的位置。"
      japanese: "彼は椅子を窓辺に寄せ、その隣を空けておいた。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: potato
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我在想，燈下那隻伸出去的手，像不像我父親的手。你第一眼看到了什麼？"
      japanese: "灯りの下で伸びているあの手、父の手に似てる気がする。君は最初にどこを見た？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "我先注意到那雙沾過土的手。"
        japanese: "土のついた手が先に目に入った。"
      nextNodeId: potato-good
    - text:
        traditionalChinese: "燈光很小，可是每個人都坐得到光裡。"
        japanese: "小さな灯りなのに、みんなその中に座ってる。"
      nextNodeId: potato-poor
  - id: cemetery
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我也走過這片墓園。可我記得的顏色跟這張不太一樣。你在那裡時，最想記住什麼？"
      japanese: "私もあそこを歩いたけど、思い出す色はこの絵と少し違う。君はあそこにいたとき、何を覚えておきたかった？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "路越走越窄，光卻一直在。"
        japanese: "道は細くなっていくのに、光はずっと残っていた。"
      nextNodeId: cemetery-good
    - text:
        traditionalChinese: "陰影下的顏色。靠近一點才發現。"
        japanese: "影の中の色。近づいてやっと気づいた。"
      nextNodeId: cemetery-poor
  - id: night
    speaker:
      traditionalChinese: "村民"
      japanese: "村の人"
    line:
      traditionalChinese: "我站了一會兒，眼睛一直被天空拉走。你看最久的是哪裡？"
      japanese: "しばらく立っていたら、何度も空に目を引かれた。君がいちばん長く見ていたのはどこ？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "星星周圍那一圈一圈的光。"
        japanese: "星のまわりを巡る光。"
      nextNodeId: night-good
    - text:
        traditionalChinese: "底下村莊的小窗。好像有人還醒著。"
        japanese: "村の小さな窓。まだ誰か起きているみたい。"
      nextNodeId: night-poor
  - id: walk-farm-pass
    speaker:
      traditionalChinese: "礦工"
      japanese: "鉱夫"
    line:
      traditionalChinese: "今天這袋有點重。你們可以幫我把它往門邊挪一點嗎？"
      japanese: "今日の袋は少し重くてね。戸口のほうへ寄せるのを手伝ってくれるか？"
    portrait: {fileID: 2800000, guid: 88d41b9c621ec2844939e163eb704c85, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "和梵谷一起把袋子移到門邊。"
        japanese: "ゴッホと一緒に袋を戸口へ運ぶ。"
      nextNodeId: walk-farm-action
  - id: walk-farm-action
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "你提起袋子的一邊，梵谷握住另一邊。放下的時候，他把袋口敞開了一點。"
      japanese: "あなたが袋の片側を持つと、ゴッホがもう片側を持った。降ろしたあと、彼は袋の口を少し開けておいた。"
