%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16a28623c3134fcaabde08787e9d8c51, type: 3}
  m_Name: Chapter 3 - The Painters
  m_EditorClassIdentifier:
  entryNodeId: home
  nodes:
  - id: home
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你來啦！我在亞爾租下了這間黃色小屋。這裡的陽光、田野和街道，讓我有好多想畫的東西！"
      japanese: "来てくれたんだね！ アルルでこの黄色い家を借りたんだ。陽の光も野原も街並みも、描きたいものばかりだよ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: home-dream
    choices: []
  - id: home-dream
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我希望這裡也能成為畫家們一起生活、交流創作的地方。"
      japanese: "ここを、画家たちが一緒に暮らし、創作について語り合える場所にしたいんだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "聽起來很棒！你一定很期待吧！"
        japanese: "素敵だね。楽しみでしょう？"
      nextNodeId: home-hope
    - text:
        traditionalChinese: "和其他畫家一起生活，不容易吵架嗎？"
        japanese: "他の画家と暮らしたら、けんかにならない？"
      nextNodeId: home-doubt
  - id: home-hope
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "當然！如果能和志同道合的朋友一起創作，那一定很幸福！"
      japanese: "もちろん！ 気の合う友人と一緒に描けたら、きっと幸せだろうな。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: home-doubt
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "或許會有不同意見吧，但我相信藝術能讓我們互相理解。"
      japanese: "意見は違うかもしれない。でも、芸術を通じて分かり合えると思うんだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: guest
    speaker:
      traditionalChinese: "高更"
      japanese: "ゴーギャン"
    line:
      traditionalChinese: "你好，我是畫家高更。文森特邀請我來亞爾一起創作，你能帶我去他的住處嗎？"
      japanese: "こんにちは。画家のゴーギャンです。フィンセントにアルルで一緒に描こうと誘われたのですが、彼の家まで案内してもらえますか？"
    portrait: {fileID: 2800000, guid: 9f662b0d40b2f40448daff9254c1a452, type: 3}
    portraitOnRight: 1
    nextNodeId: guest-answer
    choices: []
  - id: guest-answer
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "當然可以。黃色小屋就在西邊，跟我來吧。"
      japanese: "もちろん。黄色い家は西にあります。ついてきてください。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: meeting
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "高更！你終於來了！我一直想和你一起畫畫，看看我們能從彼此身上學到什麼。"
      japanese: "ゴーギャン！ ようやく来てくれたんだね。ずっと一緒に描いて、お互いから何を学べるか楽しみにしていたよ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: meeting-answer
    choices: []
  - id: meeting-answer
    speaker:
      traditionalChinese: "高更"
      japanese: "ゴーギャン"
    line:
      traditionalChinese: "好久不見，文森特。我也想看看你最近的作品。"
      japanese: "久しぶりだね、フィンセント。君の最近の作品を私も見たいと思っていたよ。"
    portrait: {fileID: 2800000, guid: 9f662b0d40b2f40448daff9254c1a452, type: 3}
    portraitOnRight: 1
    nextNodeId: meeting-plan
    choices: []
  - id: meeting-plan
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "教堂南邊的阿里斯康墓園，秋天特別美。我們一起去取景吧！"
      japanese: "教会の南にあるアリスカンは、秋がとても美しい。一緒に写生しに行こう！"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: arrival
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你看，這裡的路伸得好遠。陽光一變，整片葉子的顏色也跟著變了。"
      japanese: "見て、この道はずっと遠くまで続いている。光が変わるたびに、葉の色も変わるんだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: arrival-g
    choices: []
  - id: arrival-g
    speaker:
      traditionalChinese: "高更"
      japanese: "ゴーギャン"
    line:
      traditionalChinese: "我想找一個能讓這條路安靜下來的角度。你也走走吧，哪裡讓你停下來，就從哪裡開始。"
      japanese: "この道の静けさが残る角度を探したいな。君も歩いてみて。足が止まったところから始めればいい。"
    portrait: {fileID: 2800000, guid: 9f662b0d40b2f40448daff9254c1a452, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: survey
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "不用急著回來。你選一個地方停下，仔細看看。"
      japanese: "急いで戻らなくていいよ。どこか一か所で足を止めて、よく見てごらん。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: survey-angle
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你也在看這條路？它到了遠處，幾乎只剩一線光。"
      japanese: "君もこの道を見ていたの？ 遠くでは、光が一本残るだけみたいだ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "把那一線光留在畫裡。"
        japanese: "あの一本の光を絵に残したい。"
      nextNodeId: perspective
    - text:
        traditionalChinese: "先看看我們已經畫下的地方。"
        japanese: "先に、もう描いたところを見てみる。"
      nextNodeId: submit
  - id: submit
    speaker:
      traditionalChinese: "高更"
      japanese: "ゴーギャン"
    line:
      traditionalChinese: "讓我們看看，同一片風景能創作出什麼不同的作品。"
      japanese: "同じ風景から、どんな違う絵が生まれるか見てみよう。"
    portrait: {fileID: 2800000, guid: 9f662b0d40b2f40448daff9254c1a452, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: more
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "好啊。慢慢看，或許會發現剛才錯過的細節。"
      japanese: "いいよ。ゆっくり見れば、さっき見落としたものが見つかるかもしれない。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: perspective
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我先畫近處，再把遠處留成一小線。你往那裡看，眼睛會自己沿著路走。"
      japanese: "手前から描いて、遠くは細い線だけ残す。ほら、目がひとりでに道をたどっていく。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: leaves
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "你停在這裡啊。看葉子貼著地面的那一面。連陰影裡也有顏色。"
      japanese: "ここで足を止めたんだね。葉っぱの地面に近いところを見て。影にも色がある。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: stone
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "原來你在看石棺。靠近一點，灰色底下還透著紫。我想把那一點紫留下。"
      japanese: "石棺を見ていたんだね。近くで見ると、灰色の奥に紫が透けている。あの紫を残したい。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: complete-study
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我記得你在哪裡停下來。回去把畫攤在桌上吧，趁那道光還留在眼睛裡。"
      japanese: "君が立ち止まった場所を覚えているよ。あの光がまだ目に残っているうちに、帰って絵を広げよう。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId: complete-g
    choices: []
  - id: complete-g
    speaker:
      traditionalChinese: "高更"
      japanese: "ゴーギャン"
    line:
      traditionalChinese: "我們站在同一個地方，畫出來卻很不一樣。回小屋看看彼此的作品吧。"
      japanese: "同じ場所に立っていたのに、ずいぶん違う絵になったね。家に戻ってお互いの絵を見よう。"
    portrait: {fileID: 2800000, guid: 9f662b0d40b2f40448daff9254c1a452, type: 3}
    portraitOnRight: 1
    nextNodeId:
    choices: []
  - id: ending
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "你把門留了一條縫，回到梵谷身旁。這次聽見敲門聲，來的是鄰居和醫師。"
      japanese: "扉を少し開け、ゴッホのそばに戻った。今度、扉を叩いたのは、近所の人と医師だった。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: ending-final
    choices: []
  - id: ending-final
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "兩位畫家的道路從此分開。那天留下的作品，仍然保存著他們並肩看過的那片秋色。"
      japanese: "二人の画家は別々の道を歩んだ。あの日の絵には、二人で眺めた秋の色が今も残っている。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: survey-ready
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "我試著把你停下來看的地方畫了幾筆。想先看，還是再走一段？"
      japanese: "君が足を止めた場所を少し描いてみた。先に見る？ それとも、もう少し歩く？"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices:
    - text:
        traditionalChinese: "看看兩張習作。"
        japanese: "二枚の習作を見比べる。"
      nextNodeId: submit
    - text:
        traditionalChinese: "我想再走走。"
        japanese: "もう少し歩いてみる。"
      nextNodeId: more
  - id: house-quiet
    speaker:
      traditionalChinese: "旁白"
      japanese: "語り"
    line:
      traditionalChinese: "門關上後，小屋裡只剩桌上的兩張畫。梵谷坐了下來，許久沒有說話。"
      japanese: "扉が閉まると、家には台の上の二枚の絵が残った。ゴッホは腰を下ろし、しばらく何も言わなかった。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: house-quiet-vincent
    choices: []
  - id: house-quiet-vincent
    speaker:
      traditionalChinese: "梵谷"
      japanese: "ゴッホ"
    line:
      traditionalChinese: "可以請門外的鄰居來一趟嗎？我想找醫師。我會在這裡等你。"
      japanese: "外の人を呼んできてくれる？ お医者さんに来てほしい。僕はここで待っているよ。"
    portrait: {fileID: 2800000, guid: 1487b9a5e2268904683021a07391b96f, type: 3}
    portraitOnRight: 0
    nextNodeId:
    choices: []
  - id: neighbor-help
    speaker:
      traditionalChinese: "你"
      japanese: "あなた"
    line:
      traditionalChinese: "文森特需要醫師。我會回去陪他等，你可以幫我們去請人嗎？"
      japanese: "フィンセントにお医者さんが必要です。僕はそばで待つので、呼んできてもらえますか？"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId: neighbor-answer
    choices: []
  - id: neighbor-answer
    speaker:
      traditionalChinese: "鄰居"
      japanese: "近所の人"
    line:
      traditionalChinese: "我這就去。回去告訴他，讓門留一條縫，我們到了就敲門。"
      japanese: "すぐに行ってくる。扉を少し開けて待っていてくれ。着いたら戸を叩くから。"
    portrait: {fileID: 0}
    portraitOnRight: 0
    nextNodeId:
    choices: []
