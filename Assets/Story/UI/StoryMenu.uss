@import url("PaintedTown.uss");

.story-screen {
    flex-grow: 1;
    color: #f6eddb;
    font-size: 16px;
}

.story-start-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.story-start {
    flex-grow: 1;
    justify-content: center;
    padding-left: 9%;
    background-color: rgba(7, 12, 23, 0.20);
}

.story-title-card {
    width: 420px;
    max-width: 85%;
    padding: 42px;
    background-color: rgba(20, 34, 58, 0.96);
    border-left-width: 3px;
    border-left-color: #cda567;
    align-items: flex-start;
}

.story-title {
    font-size: 58px;
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.story-reticle {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #fff0c9;
    background-color: rgba(17, 24, 36, 0.8);
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -3px -3px;
}

.story-reticle-active {
    background-color: #ffe8ac;
    border-color: #ffe8ac;
}

.story-prompt {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 5%;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 20px;
    color: #fff0cf;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 14, 25, 0.95);
    text-shadow: 0 2px 4px rgba(10, 14, 25, 0.95);
    white-space: normal;
}

.story-controls, .story-toast {
    position: absolute;
    left: 26px;
    bottom: 24px;
    padding: 8px 14px;
    background-color: rgba(12, 18, 30, 0.84);
    color: #f2e4cb;
    font-size: 14px;
}

.story-toast {
    left: auto;
    right: 26px;
    border-right-width: 2px;
    border-right-color: #cda567;
}

.story-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 20px;
    justify-content: center;
    align-items: center;
    background-color: rgba(6, 10, 18, 0.68);
}

.story-scene-fade {
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #000000;
}

.story-transition-caption {
    color: rgb(234, 223, 198);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.story-card.chapter-three-review {
    width: 920px;
    height: 82%;
}

.chapter-three-works {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.chapter-three-work {
    flex: 1;
    min-width: 0;
    margin: 0 7px;
}

.chapter-three-image {
    flex-grow: 1;
    min-height: 0;
    background-color: #0b111c;
    border-width: 1px;
    border-color: #685739;
}

.chapter-three-caption {
    margin-top: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.chapter-three-timer {
    position: absolute;
    top: 22px;
    right: 24px;
    padding: 7px 15px;
    color: #f1d49b;
    background-color: rgba(13, 19, 32, 0.86);
    font-size: 24px;
    -unity-font-style: bold;
}

.chapter-three-subtitle {
    position: absolute;
    bottom: 14%;
    align-self: center;
    width: 58%;
    max-width: 780px;
    padding: 12px 18px;
    background-color: rgba(13, 19, 32, 0.87);
}

.chapter-three-speaker {
    color: #eac98d;
    font-size: 17px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.chapter-three-line {
    font-size: 21px;
    white-space: normal;
}

.story-card {
    width: 600px;
    max-width: 100%;
    max-height: 95%;
    padding: 28px;
    background-color: #1c2b47;
    border-top-width: 2px;
    border-top-color: #cda567;
}

.story-card-title {
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    white-space: normal;
}

.story-button.story-history-button {
    position: absolute;
    top: 18px;
    left: 20px;
    width: 44px;
    height: 42px;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
}

.story-history-icon {
    width: 22px;
    height: 16px;
    margin-bottom: 4px;
    background-color: #f0d599;
    border-radius: 4px;
}

.story-history-icon-tail {
    position: absolute;
    bottom: -2px;
    left: 4px;
    width: 7px;
    height: 7px;
    background-color: #f0d599;
    rotate: 45deg;
}

.story-history-card {
    height: 78%;
}

.story-history-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.story-history-scroll {
    flex-grow: 1;
    min-height: 0;
}

.story-history-entry {
    padding: 10px 10px 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 165, 103, 0.3);
}

.story-history-heading {
    color: #e6cf9e;
    font-size: 15px;
    margin-bottom: 4px;
    white-space: normal;
}

.story-history-text {
    font-size: 18px;
    white-space: normal;
}

.story-detail {
    color: #e6cf9e;
    margin-top: 9px;
    margin-bottom: 6px;
    min-height: 24px;
    white-space: normal;
}

.story-chapters {
    min-height: 60px;
    max-height: 278px;
    margin-top: 2px;
}

.story-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 6px;
}

.story-button {
    min-height: 42px;
    padding: 6px 15px;
    margin: 4px;
    border-width: 1px;
    border-color: #75829a;
    border-radius: 2px;
    background-color: #2d405d;
    color: #f6eddb;
    white-space: normal;
}

.story-button:hover {
    border-color: #e1bc7d;
    background-color: #35445b;
}

.story-button:focus {
    border-color: #e1bc7d;
}

.story-selected, .story-primary {
    border-color: #e8c277;
    background-color: #e8c277;
    color: #171b24;
}

.story-primary:hover {
    color: #171b24;
    background-color: #f5d9a6;
}

.story-danger {
    border-color: #a86769;
    background-color: #663438;
}

.story-danger:hover {
    border-color: #e3acac;
    background-color: #814247;
}

.story-objective {
    position: absolute;
    top: 28px;
    left: 76px;
    max-width: 52%;
    padding: 9px 13px;
    white-space: normal;
    color: #f6eddb;
    background-color: rgba(24, 39, 65, 0.94);
    border-left-width: 2px;
    border-left-color: #cda567;
}

.story-button:disabled {
    opacity: 0.55;
}

.story-chapter {
    -unity-text-align: middle-left;
    margin-left: 0;
    margin-right: 8px;
}

.drawing-tools {
    position: absolute;
    bottom: 22px;
    align-self: center;
    max-width: 95%;
    padding: 8px 12px;
    background-color: rgba(12, 18, 30, 0.96);
    border-top-width: 2px;
    border-top-color: #cda567;
}

.drawing-palette, .drawing-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.drawing-swatch {
    width: 29px;
    min-height: 29px;
    padding: 0;
    border-width: 2px;
    border-color: #303747;
}

.drawing-swatch-selected {
    border-color: #f9e2ad;
}

.drawing-eraser {
    color: #171b24;
    -unity-font-style: bold;
}

.drawing-brush {
    width: 154px;
    margin: 4px 8px;
}

.drawing-brush .unity-base-field__label {
    min-width: 0;
    margin-right: 8px;
    color: #f6eddb;
}

.drawing-power {
    position: absolute;
    align-self: center;
    top: 61%;
    width: 180px;
    height: 20px;
}

.drawing-power .unity-progress-bar__progress {
    background-color: #cda567;
}
.brush-card {
    width: 76%;
    height: 81%;
    max-width: 730px;
    max-height: 620px;
}

.brush-surface {
    width: 100%;
    height: 40%;
    min-height: 155px;
    max-height: 360px;
    flex-grow: 1;
    align-self: stretch;
    margin-top: 6px;
    margin-bottom: 6px;
}

.brush-options {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.brush-choice-selected {
    border-bottom-width: 2px;
    border-bottom-color: #dbb56f;
    background-color: #3c352b;
}

.brush-hint {
    -unity-text-align: middle-center;
    color: #ebd9b1;
    white-space: normal;
}
